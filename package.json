{
  "name": "content-os",
  "version": "0.1.0",
  "description": "CONTENT OS: gestor local de campañas, publicaciones y estadísticas de clips cortos",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-tests.cjs",
    "test:real": "node scripts/run-tests.cjs --real",
    "smoke": "electron-vite build && node scripts/run-smoke.cjs",
    "dist": "electron-vite build && electron-builder --win nsis --x64",
    "demo:data": "tsx demo/build-data.ts",
    "demo:media": "python demo/make_media.py demo/out/media.json demo/web/media",
    "demo:build": "vite build -c vite.demo.config.ts && node -e \"require('fs').renameSync('demo/dist/demo.html','demo/dist/index.html')\"",
    "demo": "npm run demo:data && npm run demo:media && npm run demo:build"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "author": "Juan",
  "build": {
    "appId": "local.contentos.app",
    "productName": "CONTENT OS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asar": false,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "CONTENT OS",
      "deleteAppDataOnUninstall": false,
      "artifactName": "CONTENT-OS-Setup-${version}.exe"
    }
  }
}
